# =========================================================
# Astra Constellation Tracer — .gitignore
# =========================================================

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
.npm
.eslintcache

# Python / Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/env/
backend/venv/
backend/.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# SQLite Database
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
backend/*.db
backend/*.db-wal
backend/*.db-journal

# Environment & Secrets
.env
backend/.env
frontend/.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# File Uploads / Captures
backend/uploads/
uploads/

# IDE / Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
